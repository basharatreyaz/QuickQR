# ==============================================================================
# QuickQR SaaS - Production Environment Template
# ==============================================================================
# Copy this file to .env on your production server:
# cp .env.production.example .env

APP_NAME="QuickQR SaaS"
APP_ENV=production
APP_URL=https://qr.yourdomain.com
APP_DEBUG=false

# Database Configuration (Use dedicated user with restricted privileges)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=quickqr_production
DB_USER=quickqr_app
DB_PASSWORD=REPLACE_WITH_STRONG_PRODUCTION_PASSWORD

# Session Security (Generate a 64+ char random secret key)
SESSION_NAME=quickqr_session
SESSION_LIFETIME=86400
SESSION_SECRET=GENERATE_64_CHARACTER_RANDOM_SECRET_HEX_HERE

# Production Rate Limiting
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_REDIRECT_MAX=300
RATE_LIMIT_REDIRECT_WINDOW=60

# Storage Paths (Ensure these directories have write permissions: chmod -R 775 storage)
QR_STORAGE_PATH=storage/qr
LOG_STORAGE_PATH=storage/logs
UPLOAD_STORAGE_PATH=storage/uploads

# Cache Subsystem (redis recommended for multi-worker production, file for single-server)
CACHE_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_PREFIX=quickqr_prod:
REDIS_TIMEOUT=0.8

# PayPal Live Gateway Settings (Admin Settings panel can also override these)
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
