APP_NAME="QuickQR SaaS"
APP_ENV=local
APP_URL=http://localhost/sass
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dynamic_qr
DB_USER=root
DB_PASSWORD=

SESSION_NAME=quickqr_session
SESSION_LIFETIME=86400
SESSION_SECRET=super_secret_session_key_dynamic_qr_saas_2026

RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_REDIRECT_MAX=120
RATE_LIMIT_REDIRECT_WINDOW=60

QR_STORAGE_PATH=storage/qr
LOG_STORAGE_PATH=storage/logs
UPLOAD_STORAGE_PATH=storage/uploads

CACHE_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_PREFIX=quickqr:
REDIS_TIMEOUT=0.8
